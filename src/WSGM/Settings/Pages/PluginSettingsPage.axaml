<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             xmlns:c="using:WSGM.Controls"
             x:Class="WSGM.Settings.Pages.PluginSettingsPage"
             x:DataType="s:SettingsViewModel">
    <!--
        Every row on this page is declared by the installed device plugin, so nothing here is a
        fixed control: the shape comes from PluginSettingsPageLayout and the controls template by
        visibility, each binding the one property its value kind uses.
    -->
    <Border Padding="16,10,16,10">
        <Panel>
            <!--
                Shown instead of an empty page. A plugin that declares no settings and a machine
                with no plugin at all look identical otherwise, and the user cannot tell whether
                something failed.
            -->
            <TextBlock Text="{Binding PluginSettingsEmptyReason}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !PluginSettingsAvailable}" />

            <ScrollViewer IsVisible="{Binding PluginSettingsAvailable}">
              <StackPanel>
                <!--
                    Authoring only. Settings mode does not activate device hardware, so there is no
                    live temperature or RPM to plot against; the curve is checked against the
                    device's own descriptor when the overlay applies it, not here.
                -->
                <Border Classes="section-header">
                    <TextBlock Text="PROFILES" />
                </Border>
                <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <ComboBox ItemsSource="{Binding DeviceProfiles}"
                                  SelectedItem="{Binding SelectedDeviceProfile}"
                                  DisplayMemberBinding="{Binding Name}"
                                  MinWidth="180"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Add curve"
                                    Click="OnAddProfile"
                                    VerticalAlignment="Center" />
                            <Button Content="Add colour"
                                    Click="OnAddColorProfile"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="Remove"
                                Click="OnRemoveProfile"
                                IsEnabled="{Binding HasSelectedDeviceProfile}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row alt" IsVisible="{Binding HasSelectedDeviceProfile}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding SelectedDeviceProfile.Name}"
                                     MaxLength="48"
                                     PlaceholderText="Profile name" />
                            <Button Grid.Column="1" Content="Edit" Click="OnEditProfileName"
                                    AutomationProperties.Name="Edit profile name with controller" />
                        </Grid>
                        <c:CurveEditor x:Name="ProfileCurve"
                                       Height="220"
                                       IsVisible="{Binding SelectedDeviceProfile.IsCurveProfile}"
                                       Points="{Binding SelectedDeviceProfile.Curve, Mode=TwoWay}" />
                        <TextBlock Classes="caption"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding SelectedDeviceProfile.IsCurveProfile}"
                                   Text="Drag a point to move it, tap the plot to add one, Delete to remove the selected point. The device checks the curve against its own limits when the profile is applied." />
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding SelectedDeviceProfile.IsColorProfile}">
                            <ColorPicker x:Name="ProfileColor"
                                         HorizontalAlignment="Left"
                                         Color="{Binding SelectedDeviceProfile.PickerColor, Mode=TwoWay}" />
                            <TextBlock Text="{Binding SelectedDeviceProfile.ColorHex}"
                                       Classes="caption" VerticalAlignment="Center" />
                            <Button Content="Edit colour" Click="OnEditProfileColor"
                                    AutomationProperties.Name="Edit profile color with controller" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding PluginSettingSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="s:PluginSettingSectionViewModel">
                            <StackPanel Margin="0,0,0,8">
                                <Border Classes="section-header">
                                    <TextBlock Text="{Binding Title}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="s:PluginSettingRowViewModel">
                                            <Border Classes="setting-row">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock Text="{Binding Label}"
                                                               Classes="setting-title"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsChecked="{Binding BooleanValue}"
                                                                  IsVisible="{Binding IsToggle}"
                                                                  VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                IsVisible="{Binding IsRange}"
                                                                VerticalAlignment="Center">
                                                        <Slider Width="220"
                                                                Minimum="{Binding Minimum}"
                                                                Maximum="{Binding Maximum}"
                                                                TickFrequency="{Binding Step}"
                                                                IsSnapToTickEnabled="True"
                                                                Value="{Binding IntegerValue}"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding IntegerValue}"
                                                                   Classes="caption"
                                                                   MinWidth="40"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1"
                                                              MinWidth="180"
                                                              ItemsSource="{Binding Choices}"
                                                              SelectedItem="{Binding SelectedChoice}"
                                                              DisplayMemberBinding="{Binding Label}"
                                                              IsVisible="{Binding IsChoice}"
                                                              VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                                IsVisible="{Binding IsText}">
                                                        <TextBox MinWidth="180"
                                                                 MaxLength="{Binding MaximumLength}"
                                                                 Text="{Binding TextValue}"
                                                                 VerticalAlignment="Center" />
                                                        <Button Content="Edit" Click="OnEditPluginText"
                                                                AutomationProperties.Name="Edit plugin text value with controller" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                                IsVisible="{Binding IsColor}">
                                                        <ColorPicker Color="{Binding PickerColor, Mode=TwoWay}"
                                                                     VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ColorHex}" Classes="caption"
                                                                   VerticalAlignment="Center" />
                                                        <Button Content="Edit colour" Click="OnEditPluginColor"
                                                                AutomationProperties.Name="Edit plugin color with controller" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
        </Panel>
    </Border>
</UserControl>
