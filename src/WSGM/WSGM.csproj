<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wsgm.ico</ApplicationIcon>
    <AssemblyName>WSGM</AssemblyName>
    <RootNamespace>WSGM</RootNamespace>
    <Version>1.5.1</Version>

    <!-- NativeAOT single exe -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Managed COM interop stays off: nothing here needs it (the radio and volume
         helpers own their COM/WinRT calls behind a flat C ABI), and leaving it off
         keeps the NativeAOT image smaller. Avalonia only required this before 12.0. -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- A resident shell on an 8-16 GB handheld: favor small heap over GC
         throughput (no background GC thread; see also ConserveMemory below). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Steam Input Lease injects this gate into steam.exe while a WSGM input
         surface owns a lease. Keep both x64 native libraries beside the AOT
         executable; the managed binding resolves them by their file names. -->
    <None Include="Native\SteamInputLease\*.dll"
          Condition="'$(SkipNativeArtifacts)' != 'true'"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- steam-input-lease.exe is deliberately NOT shipped: WSGM.Launch.exe is the
         single user-facing wrapper and links the same binding mirror, so it holds
         the lease itself (and carries the CLI's status/rescan diagnostics).
         The Rust CLI stays a development tool inside native\SteamInput. -->
    <None Include="Native\SteamInputLease\*.txt"
          Condition="'$(SkipNativeArtifacts)' != 'true'"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\SteamInputLease\*.md"
          Condition="'$(SkipNativeArtifacts)' != 'true'"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- Wi-Fi and Bluetooth control. WinRT radio power and custom pairing cannot
         be reached from this NativeAOT executable at all (managed COM interop is
         off), so the helper owns those calls and the flat wlanapi ones behind a
         C ABI. The probe beside it answers, on the device, what documentation
         does not: whether radio control works with no shell, and whether the
         location-consent gate blocks the Wi-Fi scan. -->
    <None Include="Native\Radio\*"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- Third-party license texts for managed packages we redistribute. Same
         ship-beside-the-exe pattern as the SteamInputLease license files above;
         the installer lists them explicitly in [Files]. -->
    <None Include="Licenses\*.txt"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Boot-splash spinner styles (Unlicense; the license text ships from
         Licenses\ beside the exe). Vendored as SOURCE, not as the NuGet package:
         the published package is built against Avalonia 11 and its precompiled
         XAML throws on Avalonia 12. Building it here compiles the styles against
         the Avalonia we ship. See its csproj for the full reasoning. -->
    <ProjectReference
        Include="..\..\third_party\LoadingIndicators.Avalonia\LoadingIndicators.Avalonia\LoadingIndicators.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 1-9: how hard the GC works to keep the heap small; 9 = maximum. Reads
         fine under NativeAOT (embedded runtime config). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pinned exactly: a shell replacement must ship the patch level that was
         tested on device, and rebuilding a tag must reproduce the same binaries. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- FluentAvaloniaTheme (the runtime accent pipeline regenerates its shades via
         CustomAccentColor) plus WinUI-style controls such as FAInfoBar and ToggleSwitch.
         3.x is the first line built against Avalonia 12. -->
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <!-- Pinned: FluentAvaloniaUI's transitive ColorPicker can resolve below the
         Avalonia version above — the explicit pin removes the version skew. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <!-- Controller input. Plain-DllImport bindings (AOT-safe), bundles native SDL3.dll
         for win-x64 so build and publish output pick it up automatically. -->
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
  </ItemGroup>
</Project>
