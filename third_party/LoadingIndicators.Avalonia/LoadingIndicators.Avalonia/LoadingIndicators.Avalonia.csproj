<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Vendored from https://github.com/moviegear/LoadingIndicators.Avalonia (Unlicense,
      public domain; LICENSE.md ships beside WSGM.exe).

      Referenced as source rather than as a NuGet package because the published
      package has no build for Avalonia 12: its precompiled XAML binds through
      Avalonia.Markup.Xaml.MarkupExtensions.CompiledBindings.CompiledBindingPathBuilder,
      which Avalonia 12 removed, so every indicator style throws the moment it is
      rendered. NativeAOT reports this as "will always throw" at publish time.
      Building the XAML here means it compiles against the Avalonia we actually
      ship, and a future breaking change fails the build instead of the splash.

      Local changes are listed in ../PORTING-NOTES.md. Keep them there, so the
      diff against upstream stays obvious if this is ever re-synced.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Third-party source: its doc comments are not WSGM's to complete, and
             the repo builds with warnings as errors. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Pinned to the exact Avalonia WSGM ships; a mismatch here is what the
             NuGet package's breakage was. -->
        <PackageReference Include="Avalonia" Version="12.1.2" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="**\*.axaml">
            <SubType>Designer</SubType>
        </AvaloniaResource>
    </ItemGroup>
</Project>
